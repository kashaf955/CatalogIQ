{
  "name": "catalogiq-backend",
  "version": "0.1.0",
  "description": "CatalogIQ backend - compares own product catalog against competitor websites and helps update products",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/queue/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.7.9",
    "bullmq": "^5.34.5",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "papaparse": "^5.7.0",
    "playwright": "^1.49.1",
    "socket.io": "^4.8.1",
    "string-similarity": "^4.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/string-similarity": "^4.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
