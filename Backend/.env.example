PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/catalogiq

# Background jobs (BullMQ). App boots fine without Redis running; queue-based
# processing (Backend/src/queue/worker.ts) simply won't run until this is reachable.
REDIS_URL=redis://127.0.0.1:6379

# Claude API for ambiguous-match verification (spec section 17). Without this,
# ambiguous matches are left as "needs_review" with no AI reasoning attached.
ANTHROPIC_API_KEY=

# Optional supporting search/scraping tools (spec section 15/24).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
APIFY_API_TOKEN=
